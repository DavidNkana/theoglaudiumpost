# Production build configuration.
#
# The Supabase publishable key is a public client key: it ships inside the
# browser bundle and grants no access on its own. Every read and write is
# limited by Row Level Security on the database. The service_role key and the
# management access token are secrets and are deliberately NOT in this file.
#
# Set VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY in the Vercel project to
# override these values — environment variables take precedence over this file.
VITE_SUPABASE_URL=https://pgpujjhhkkfnjywdpgln.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_zE2O-D09MPBPuHt4XpOR4g_kMlxHrex

# Show the advertisement slots on the site.
#
# The banner and sidebar slots are switched off by default. The advertisement
# slots are filled by the ads an administrator enters.
VITE_SHOW_ADS=true
