{
  "name": "lauduim_biz_app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:web": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "coverage": "vitest run --coverage",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "verify": "npm run arch && npm run coverage && npm run build",
    "cap:sync": "npx cap sync",
    "cap:build": "npm run build && npm run cap:sync",
    "cap:open:android": "npx cap open android",
    "cap:run:android": "npx cap run android",
    "cap:build:android": "npm run cap:build && npm run cap:open:android",
    "cap:bootstrap:android": "npm run build:web && cap sync android",
    "cap:bootstrap:ios": "npm run build:web && cap sync ios",
    "assets:init": "npx @capacitor/assets init --ios --android --force",
    "assets:generate": "npx @capacitor/assets generate  --ios --android",
    "cf:dev": "npm run build && wrangler dev --persist-to=./.wrangler/state",
    "cf:deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/app": "^7.0.1",
    "@capacitor/cli": "^7.4.0",
    "@capacitor/core": "^7.4.0",
    "@capacitor/ios": "^7.4.0",
    "@capacitor/splash-screen": "^7.0.1",
    "@capacitor/status-bar": "^7.0.1",
    "@onesignal/onesignal-vue3": "^2.2.1",
    "@sentry/node": "^9.12.0",
    "@sentry/vue": "^9.12.0",
    "@vueup/vue-quill": "^1.2.0",
    "@vueuse/core": "^13.9.0",
    "@vueuse/router": "^13.9.0",
    "axios": "^1.8.4",
    "bootstrap": "^5.3.5",
    "bootstrap-icons": "^1.11.3",
    "chart.js": "^4.4.9",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "jwt-decode": "^4.0.0",
    "lauduim_biz_app": "file:",
    "lodash": "^4.17.21",
    "qs-stringify": "^1.2.1",
    "sweetalert2": "^11.19.1",
    "v3-infinite-loading": "^1.3.2",
    "vue": "^3.5.13",
    "vue-chartjs": "^5.3.2",
    "vue-flatpickr-component": "^12.0.0",
    "vue-router": "^4.5.0",
    "vue-select": "^4.0.0-beta.6",
    "vue3-masonry-css": "^1.0.8",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@playwright/test": "^1.60.0",
    "@vite-pwa/assets-generator": "^1.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-istanbul": "^2.1.9",
    "@vitest/coverage-v8": "^2.1.9",
    "@vue/test-utils": "^2.4.11",
    "dependency-cruiser": "^17.4.3",
    "jsdom": "^29.1.1",
    "prettier": "^3.5.3",
    "sass": "^1.86.3",
    "sass-loader": "^16.0.5",
    "vite": "7.1.11",
    "vite-plugin-pwa": "^1.1.0",
    "vite-plugin-vue-devtools": "^8.0.3",
    "vitest": "^2.1.9"
  }
}
