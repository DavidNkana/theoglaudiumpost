default_platform(:ios)

platform :ios do
  desc "Build the Laudium Post Capacitor app via match, upload to TestFlight, submit to App Store review"
  lane :beta do
    setup_ci(force: true)

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH"),
      in_house: false
    )

    match(
      type: "appstore",
      api_key: api_key,
      app_identifier: "co.za.laudiumpost",
      git_url: "https://dev.azure.com/Safai/Laudium-post/_git/Laudium-post-certs",
      git_branch: "main",
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTHORIZATION"],
      readonly: false
    )

    profile_name = ENV["sigh_co.za.laudiumpost_appstore"] ||
                   (lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING] || {})["co.za.laudiumpost"]
    profile_path = ENV["sigh_co.za.laudiumpost_appstore_profile-path"]
    sh("security cms -D -i '#{profile_path}' -o /tmp/laudium.plist")
    team_id = sh("/usr/libexec/PlistBuddy -c 'Print :TeamIdentifier:0' /tmp/laudium.plist").strip

    update_code_signing_settings(
      path: "ios/App/App.xcodeproj",
      use_automatic_signing: false,
      team_id: team_id,
      targets: ["App"],
      bundle_identifier: "co.za.laudiumpost",
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name
    )

    build_num = begin
      (latest_testflight_build_number(api_key: api_key, app_identifier: "co.za.laudiumpost") + 1).to_s
    rescue StandardError
      Time.now.strftime("%Y%m%d%H%M")
    end
    set_info_plist_value(path: "ios/App/App/Info.plist", key: "CFBundleVersion", value: build_num)
    set_info_plist_value(path: "ios/App/App/Info.plist", key: "ITSAppUsesNonExemptEncryption", value: false)
    UI.message("Set CFBundleVersion to #{build_num}")

    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      clean: true,
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: { "co.za.laudiumpost" => profile_name }
      }
    )

    upload_to_testflight(api_key: api_key, app_identifier: "co.za.laudiumpost", skip_waiting_for_build_processing: false)

    begin
      upload_to_app_store(
        api_key: api_key,
        skip_binary_upload: true,
        skip_metadata: true,
        skip_screenshots: true,
        submit_for_review: true,
        automatic_release: false,
        force: true,
        precheck_include_in_app_purchases: false,
        submission_information: { add_id_info_uses_idfa: false }
      )
    rescue => e
      UI.important("TestFlight upload succeeded; App Store review submission was skipped: #{e.message}")
    end
  end
end
