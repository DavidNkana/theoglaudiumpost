{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./tests/e2e",
    "lib": ["ES2020"]
  },
  "include": ["tests/e2e/**/*.ts"],
  "exclude": ["node_modules"]
}
