# API base URLs selected by Vite mode. Include the backend API path and a
# trailing slash, for example https://api.example.com/laudium/api/v1/.
VITE_DEV_API_BASE_URL=
VITE_TEST_API_BASE_URL=
# Required for production builds (including Vercel). Vercel hosts only the
# frontend; it does not proxy /api/v1/ to a backend automatically.
VITE_PROD_API_BASE_URL=
