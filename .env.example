# Supabase connection (the only backend this app has).
#
# VITE_SUPABASE_URL is the project URL and VITE_SUPABASE_ANON_KEY is the
# public anon key. The anon key is safe to ship to the browser: every read and
# write is limited by Row Level Security on the database. The service_role key
# must never be placed here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Legacy API base URLs.
#
# The application no longer talks to a separate API server — it reads and
# writes Supabase directly. These are kept only so older tooling that still
# references them does not break.
VITE_DEV_API_BASE_URL=/api/v1/
VITE_TEST_API_BASE_URL=/api/v1/
VITE_PROD_API_BASE_URL=
