# API base URLs selected by Vite mode. Values are canonicalized to exactly one
# trailing slash. Development/test may use the same-origin placeholder below.
VITE_DEV_API_BASE_URL=/api/v1/
VITE_TEST_API_BASE_URL=/api/v1/
# Required for production builds (including Vercel). Vercel hosts only the
# frontend; it does not proxy /api/v1/ to a backend automatically.
# Must be the real HTTPS backend URL, for example:
# VITE_PROD_API_BASE_URL=https://api.example.com/laudium/api/v1/
VITE_PROD_API_BASE_URL=
